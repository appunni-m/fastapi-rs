{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-rs.dev/schemas/python-api-workflow-result/3",
  "title": "FastAPI-RS direct Python API workflow result v3",
  "description": "Identity-checked observations from one isolated Python product process. Results are generated evidence, never workflow inputs.",
  "type": "object",
  "required": ["schema", "run_id", "started_at", "finished_at", "product", "identity", "manifest", "input", "workload", "command", "status", "cases", "infrastructure_errors"],
  "properties": {
    "schema": {"const": "fastapi-rs/python-api-workflow-result@3"},
    "run_id": {"type": "string", "format": "uuid"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "product": {"enum": ["oracle", "target"]},
    "identity": {"$ref": "#/$defs/identity"},
    "manifest": {"$ref": "#/$defs/digestRef"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"const": "fastapi-rs/python-api-workflow@2"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "factory"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "factory": {"type": "string", "minLength": 1}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"const": "."}
      }
    },
    "status": {"enum": ["completed", "infrastructure_failed"]},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "infrastructure_errors": {"type": "array", "items": {"$ref": "#/$defs/infrastructureError"}}
  },
  "allOf": [
    {
      "if": {"properties": {"product": {"const": "oracle"}}},
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "distribution": {"const": "fastapi"},
              "repositories": {
                "properties": {
                  "fastapi_source": {"type": "string", "minLength": 1},
                  "starlette_source": {"type": "string", "minLength": 1}
                }
              },
              "target_revision": {"type": "null"},
              "source_tree_sha256": {"type": "null"},
              "target_binary_sha256": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"product": {"const": "target"}}},
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "distribution": {"const": "fastapi-rs"},
              "repositories": {
                "properties": {
                  "fastapi_source": {"type": "null"},
                  "starlette_source": {"type": "null"},
                  "fastapi_rs": {"type": "string", "minLength": 1},
                  "starlette_rs": {"type": "string", "minLength": 1}
                }
              },
              "target_revision": {"type": "string", "minLength": 1},
              "source_tree_sha256": {"$ref": "#/$defs/sha256"},
              "target_binary_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version", "python", "platform", "repositories", "target_revision", "source_tree_sha256", "target_binary_sha256", "packages"],
      "properties": {
        "distribution": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "release", "machine"],
          "properties": {
            "system": {"type": "string", "minLength": 1},
            "release": {"type": "string", "minLength": 1},
            "machine": {"type": "string", "minLength": 1}
          }
        },
        "repositories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fastapi_source", "starlette_source", "fastapi_rs", "starlette_rs"],
          "properties": {
            "fastapi_source": {"type": ["string", "null"]},
            "starlette_source": {"type": ["string", "null"]},
            "fastapi_rs": {"type": ["string", "null"]},
            "starlette_rs": {"type": ["string", "null"]}
          }
        },
        "target_revision": {"type": ["string", "null"]},
        "source_tree_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "target_binary_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "packages": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "jsonValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "message"],
      "properties": {"class": {"type": "string", "minLength": 1}, "message": {"type": "string"}}
    },
    "returnValueObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "values"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "kind": {"const": "python_return_value"},
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {
            "value": {"$ref": "#/$defs/jsonValue"},
            "nonfinite_floats": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "value"],
                "properties": {
                  "path": {"type": "string"},
                  "value": {"enum": ["nan", "positive_infinity", "negative_infinity"]}
                }
              }
            }
          }
        }
      }
    },
    "attributeValueObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "values"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "kind": {"const": "python_attribute_value"},
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {"value": {"$ref": "#/$defs/jsonValue"}}
        }
      }
    },
    "callOutcomeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "values"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "kind": {"const": "python_call_outcome"},
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "outcome": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status"],
                  "properties": {"status": {"const": "returned"}}
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "error"],
                  "properties": {
                    "status": {"const": "raised"},
                    "error": {"$ref": "#/$defs/error"}
                  }
                }
              ]
            }
          }
        }
      }
    },
    "signatureObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "values"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "kind": {"const": "python_signature"},
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signature"],
          "properties": {"signature": {"$ref": "#/$defs/signature"}}
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "return_annotation"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/signatureParameter"}
        },
        "return_annotation": {"type": ["string", "null"]}
      }
    },
    "signatureParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "has_default", "default", "annotation"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "has_default": {"type": "boolean"},
        "default": {"$ref": "#/$defs/jsonValue"},
        "annotation": {"type": ["string", "null"]}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "status", "observations"],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}},
          "then": {
            "not": {"required": ["error"]},
            "properties": {"observations": {"minItems": 1}}
          }
        },
        {
          "if": {"properties": {"status": {"const": "product_error"}}},
          "then": {
            "required": ["error"],
            "properties": {"observations": {"maxItems": 0}}
          }
        }
      ],
      "properties": {
        "probe_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "status": {"enum": ["completed", "product_error"]},
        "error": {"$ref": "#/$defs/error"},
        "observations": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/returnValueObservation"},
              {"$ref": "#/$defs/attributeValueObservation"},
              {"$ref": "#/$defs/callOutcomeObservation"},
              {"$ref": "#/$defs/signatureObservation"}
            ]
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "probes"],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}},
          "then": {"not": {"required": ["error"]}}
        },
        {
          "if": {"properties": {"status": {"const": "product_error"}}},
          "then": {"required": ["error"]}
        }
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^fastapi(?:\\.[a-z0-9][a-z0-9-]*){2,}$"},
        "status": {"enum": ["completed", "product_error"]},
        "error": {"$ref": "#/$defs/error"},
        "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}}
      }
    },
    "infrastructureError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message"],
      "properties": {"stage": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
    }
  }
}
