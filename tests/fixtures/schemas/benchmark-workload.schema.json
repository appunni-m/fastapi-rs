{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastapi-rs/benchmark-workload@1",
  "title": "FastAPI-RS direct ASGI benchmark workload",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "python_identity",
    "input",
    "correctness_gate",
    "subjects",
    "timing",
    "reporting"
  ],
  "properties": {
    "schema": {"const": "fastapi-rs/benchmark-workload@1"},
    "id": {"type": "string", "pattern": "^fastapi\\.[a-z0-9][a-z0-9.-]*$"},
    "title": {"type": "string", "minLength": 1},
    "python_identity": {
      "type": "object",
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"const": "CPython"},
        "version": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["path", "case_id"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^tests/fixtures/inputs/parity/[A-Za-z0-9._/-]+\\.json$"
        },
        "case_id": {"type": "string", "pattern": "^fastapi(?:\\.[a-z0-9][a-z0-9-]*){2,}$"},
        "action_id": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "correctness_gate": {
      "type": "object",
      "required": [
        "parity_runner",
        "parity_case_id",
        "required_comparison",
        "require_equal_untimed_observation"
      ],
      "properties": {
        "parity_runner": {"const": "scripts/parity/run_first_slice.py"},
        "parity_case_id": {"type": "string", "pattern": "^fastapi(?:\\.[a-z0-9][a-z0-9-]*){2,}$"},
        "required_comparison": {"const": "all-selected-cases-pass"},
        "require_equal_untimed_observation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["status", "headers", "body"]}
        }
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/subject"}
    },
    "timing": {
      "type": "object",
      "required": [
        "boundary",
        "excludes",
        "warmups",
        "rounds",
        "samples_per_round",
        "concurrency",
        "metrics",
        "raw_samples"
      ],
      "properties": {
        "boundary": {"type": "string", "minLength": 1},
        "includes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "excludes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "warmups": {"type": "integer", "minimum": 1},
        "rounds": {"type": "integer", "minimum": 1},
        "samples_per_round": {"type": "integer", "minimum": 1},
        "concurrency": {"const": 1},
        "metrics": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "per-request latency nanoseconds: min, median, p95, p99, max, mean",
              "sequential request-loop throughput"
            ]
          }
        },
        "raw_samples": {"const": "retain all per-request latency samples"}
      },
      "additionalProperties": false
    },
    "reporting": {
      "type": "object",
      "required": ["fastapi_rs_over_fastapi"],
      "properties": {
        "fastapi_rs_over_fastapi": {"const": "report median and p95 ratios only"},
        "starlette_control": {
          "enum": [
            "contextual baseline; do not subtract from FastAPI timings",
            "omitted because standalone Starlette has no FastAPI dependency injection semantics"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "environment"],
          "properties": {
            "id": {"const": "fastapi-0.141.1"},
            "kind": {"const": "fastapi"},
            "environment": {"const": "oracle"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "environment"],
          "properties": {
            "id": {"const": "fastapi-rs-release"},
            "kind": {"const": "fastapi-rs"},
            "environment": {"const": "target"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "environment"],
          "properties": {
            "id": {"const": "starlette-1.6.0-control"},
            "kind": {"const": "starlette-control"},
            "environment": {"const": "oracle"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
