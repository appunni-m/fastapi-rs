{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-rs.dev/schemas/python-api-comparison/1",
  "title": "FastAPI-RS direct Python API comparison result",
  "description": "Exact comparison of public API observations from isolated pinned oracle and target processes.",
  "type": "object",
  "required": ["schema", "run_id", "created_at", "scope", "manifest", "input", "source_result", "target_result", "command", "status", "summary", "cases", "infrastructure_errors"],
  "properties": {
    "schema": {"const": "fastapi-rs/python-api-comparison@1"},
    "run_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "direct-python-api"},
    "manifest": {"$ref": "#/$defs/digestRef"},
    "input": {
      "allOf": [
        {"$ref": "#/$defs/digestRef"},
        {"type": "object", "required": ["schema"], "properties": {"schema": {"const": "fastapi-rs/python-api-workflow@1"}}}
      ]
    },
    "source_result": {"$ref": "#/$defs/resultRef"},
    "target_result": {"$ref": "#/$defs/resultRef"},
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv", "cwd"],
      "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd": {"const": "."}}
    },
    "status": {"const": "completed"},
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["selected", "passed", "failed", "not_run"],
      "properties": {"selected": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "not_run": {"type": "integer", "minimum": 0}}
    },
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "infrastructure_errors": {"type": "array", "maxItems": 0}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digestRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema": {"type": "string", "minLength": 1}}
    },
    "resultRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "run_id", "product"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "run_id": {"type": "string", "format": "uuid"}, "product": {"enum": ["oracle", "target"]}}
    },
    "jsonValue": {
      "anyOf": [
        {"type": "null"}, {"type": "boolean"}, {"type": "integer"}, {"type": "number"}, {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["case_id", "outcome", "diffs"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["pass", "fail", "not_run"]},
        "reason": {"type": "string", "minLength": 1},
        "diffs": {"type": "array", "items": {"$ref": "#/$defs/diff"}}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "not_run"}}}, "then": {"required": ["reason"]}},
        {"if": {"properties": {"outcome": {"enum": ["pass", "fail"]}}}, "then": {"not": {"required": ["reason"]}}}
      ]
    },
    "diff": {
      "type": "object", "additionalProperties": false, "required": ["probe_id", "path", "comparison", "source", "target"],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "comparison": {"const": "exact"},
        "source": {"$ref": "#/$defs/jsonValue"},
        "target": {"$ref": "#/$defs/jsonValue"}
      }
    }
  }
}
