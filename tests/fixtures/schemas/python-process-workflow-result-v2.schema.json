{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-rs.dev/schemas/python-process-workflow-result/2",
  "title": "FastAPI-RS Python process workflow result v2",
  "description": "Identity-bound receipts for isolated-tree process runs and bounded loopback HTTP server lifecycles.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "started_at",
    "finished_at",
    "product",
    "profile",
    "identity",
    "manifest",
    "input",
    "command",
    "status",
    "cases",
    "infrastructure_errors"
  ],
  "properties": {
    "schema": {
      "const": "fastapi-rs/python-process-workflow-result@2"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "enum": [
        "oracle",
        "target"
      ]
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "identity": {
      "oneOf": [
        {
          "$ref": "#/$defs/identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "$ref": "#/$defs/digestReference"
    },
    "input": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "schema"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "const": "fastapi-rs/python-process-workflow@2"
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "mode",
        "entrypoint"
      ],
      "properties": {
        "mode": {
          "enum": [
            "oracle",
            "target"
          ]
        },
        "entrypoint": {
          "oneOf": [
            {
              "$ref": "#/$defs/fileIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "unresolved"
      ]
    },
    "unresolved_reason": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "maxItems": 128
    },
    "infrastructure_errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/infrastructureError"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product": {
            "const": "oracle"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "mode": {
                "const": "oracle"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "target"
          }
        },
        "required": [
          "product"
        ]
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "mode": {
                "const": "target"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unresolved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "product": {
            "const": "target"
          },
          "profile": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            },
            "required": [
              "reason"
            ]
          },
          "identity": {
            "type": "null"
          },
          "command": {
            "properties": {
              "entrypoint": {
                "type": "null"
              }
            }
          },
          "cases": {
            "maxItems": 0
          },
          "unresolved_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "unresolved_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "command": {
            "properties": {
              "entrypoint": {
                "$ref": "#/$defs/fileIdentity"
              }
            }
          },
          "cases": {
            "minItems": 1
          },
          "infrastructure_errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "const": "target"
          },
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "product",
          "status"
        ]
      },
      "then": {
        "properties": {
          "identity": {
            "required": [
              "distribution",
              "version",
              "target_revision",
              "source_tree_sha256",
              "target_binary_sha256"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "digestReference": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "fileIdentity": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_sha256",
        "python",
        "packages",
        "repositories",
        "entrypoint"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "distribution": {
          "const": "fastapi-rs"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "target_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "python": {
          "type": "object",
          "required": [
            "implementation",
            "version",
            "path",
            "sha256"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "entrypoint": {
          "$ref": "#/$defs/fileIdentity"
        }
      },
      "additionalProperties": false
    },
    "byteRecord": {
      "type": "object",
      "required": [
        "encoding",
        "data",
        "sha256",
        "length_bytes"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 1398104
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "length_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "selector",
        "value"
      ],
      "properties": {
        "selector": {
          "enum": [
            "process.exit_code",
            "process.stdout",
            "process.stderr",
            "http.status",
            "http.body.bytes"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "$ref": "#/$defs/byteRecord"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selector": {
                "enum": [
                  "process.exit_code",
                  "http.status"
                ]
              }
            },
            "required": [
              "selector"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selector": {
                "enum": [
                  "process.stdout",
                  "process.stderr",
                  "http.body.bytes"
                ]
              }
            },
            "required": [
              "selector"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/byteRecord"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "caseCommand": {
      "type": "object",
      "required": [
        "argv",
        "cwd",
        "environment",
        "execution"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 64
        },
        "cwd": {
          "$ref": "#/$defs/cwdIdentity"
        },
        "environment": {
          "type": "object",
          "required": [
            "set",
            "unset",
            "inherited"
          ],
          "properties": {
            "set": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "COLUMNS",
                  "FASTAPI_ENV",
                  "FASTAPI_PUBLIC_URL",
                  "LINES",
                  "NO_COLOR",
                  "PORT",
                  "PYTHONIOENCODING",
                  "TERM"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 4096
              },
              "maxProperties": 8
            },
            "unset": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "COLUMNS",
                  "FASTAPI_ENV",
                  "FASTAPI_PUBLIC_URL",
                  "LINES",
                  "NO_COLOR",
                  "PORT",
                  "PYTHONIOENCODING",
                  "TERM"
                ]
              }
            },
            "inherited": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "execution": {
          "$ref": "#/$defs/execution"
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "status",
        "exit_code",
        "observations",
        "command",
        "timeout_seconds",
        "duration_seconds"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed",
            "timeout",
            "spawn_error",
            "readiness_timeout",
            "server_exited",
            "request_error",
            "output_limit",
            "shutdown_timeout",
            "staging_error",
            "capture_error",
            "child_process_leak"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          },
          "maxItems": 5
        },
        "command": {
          "$ref": "#/$defs/caseCommand"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "error": {
          "type": "object",
          "required": [
            "type",
            "message"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "required": [
            "readiness",
            "request",
            "shutdown",
            "port"
          ],
          "properties": {
            "readiness": {
              "enum": [
                "ready",
                "timeout",
                "process_exited",
                "not_reached"
              ]
            },
            "request": {
              "enum": [
                "completed",
                "failed",
                "not_attempted"
              ]
            },
            "shutdown": {
              "enum": [
                "graceful",
                "forced",
                "not_started",
                "failed"
              ]
            },
            "port": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer"
              }
            },
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "timeout"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "spawn_error"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "observations": {
                "maxItems": 0
              },
              "status": {
                "const": "spawn_error"
              }
            },
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "properties": {
                  "execution": {
                    "properties": {
                      "kind": {
                        "const": "http-server"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                }
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "required": [
              "lifecycle"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "lifecycle": {
                "type": "object",
                "properties": {
                  "readiness": {
                    "const": "ready"
                  },
                  "request": {
                    "const": "completed"
                  },
                  "shutdown": {
                    "const": "graceful"
                  }
                },
                "required": [
                  "readiness",
                  "request",
                  "shutdown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "timeout",
                  "spawn_error",
                  "readiness_timeout",
                  "server_exited",
                  "request_error",
                  "output_limit",
                  "shutdown_timeout",
                  "staging_error",
                  "capture_error",
                  "child_process_leak"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              },
              "command": {
                "properties": {
                  "execution": {
                    "properties": {
                      "kind": {
                        "const": "http-server"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                }
              }
            },
            "required": [
              "status",
              "command"
            ]
          },
          "then": {
            "properties": {
              "lifecycle": {
                "properties": {
                  "port": {
                    "type": "integer"
                  }
                },
                "required": [
                  "port"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "infrastructureError": {
      "type": "object",
      "required": [
        "case_id",
        "kind",
        "message"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "timeout",
            "spawn_error",
            "readiness_timeout",
            "server_exited",
            "request_error",
            "output_limit",
            "shutdown_timeout",
            "staging_error",
            "capture_error",
            "child_process_leak"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cwdIdentity": {
      "type": "object",
      "required": [
        "kind",
        "tree_sha256",
        "file_count",
        "total_bytes"
      ],
      "properties": {
        "kind": {
          "const": "isolated-tree"
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "command"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "readiness",
            "request",
            "shutdown"
          ],
          "properties": {
            "kind": {
              "const": "http-server"
            },
            "readiness": {
              "type": "object",
              "required": [
                "path",
                "timeout_seconds",
                "poll_interval_ms"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/requestPath"
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                },
                "poll_interval_ms": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 500
                }
              },
              "additionalProperties": false
            },
            "request": {
              "type": "object",
              "required": [
                "method",
                "path",
                "headers",
                "body",
                "timeout_seconds"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS"
                  ]
                },
                "path": {
                  "$ref": "#/$defs/requestPath"
                },
                "headers": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": {
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "body": {
                  "type": "string",
                  "maxLength": 65536
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15
                }
              },
              "additionalProperties": false
            },
            "shutdown": {
              "type": "object",
              "required": [
                "grace_seconds"
              ],
              "properties": {
                "grace_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "requestPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/(?!/)[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*$"
    }
  }
}
