{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-rs.dev/schemas/python-process-workflow/1",
  "title": "FastAPI-RS Python process workflow input v1",
  "description": "Input-only process invocations against explicitly identified isolated oracle and target profiles.",
  "type": "object",
  "required": ["schema", "profiles", "cases"],
  "properties": {
    "schema": {"const": "fastapi-rs/python-process-workflow@1"},
    "profiles": {"$ref": "#/$defs/profiles"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profiles": {
      "type": "object",
      "required": ["oracle", "target"],
      "properties": {
        "oracle": {
          "const": "fastapi-0.157.0-starlette-1.6.0-cpython-3.12.13-standard"
        },
        "target": {"const": "fastapi-rs-python-consumer"}
      },
      "additionalProperties": false
    },
    "caseId": {
      "type": "string",
      "pattern": "^fastapi\\.cli\\.process\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "argv": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [{"const": "fastapi"}],
      "items": {"type": "string", "minLength": 1}
    },
    "cwd": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"const": "isolated-empty"}},
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["set", "unset"],
      "properties": {
        "set": {
          "type": "object",
          "propertyNames": {
            "enum": ["COLUMNS", "FASTAPI_ENV", "LINES", "NO_COLOR", "PYTHONIOENCODING", "TERM"]
          },
          "additionalProperties": {"type": "string"}
        },
        "unset": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["COLUMNS", "FASTAPI_ENV", "LINES", "NO_COLOR", "PYTHONIOENCODING", "TERM"]
          }
        }
      },
      "additionalProperties": false
    },
    "sourceEvidence": {
      "type": "object",
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "kind": {
          "enum": [
            "upstream_test",
            "upstream_documentation",
            "upstream_implementation_source",
            "upstream_project_metadata",
            "upstream_lockfile"
          ]
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "upstream_test"}}, "required": ["kind"]},
          "then": {"properties": {"path": {"pattern": "^tests/.+\\.py$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "upstream_documentation"}}, "required": ["kind"]},
          "then": {"properties": {"path": {"pattern": "^docs/en/docs/.+\\.md$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "upstream_implementation_source"}}, "required": ["kind"]},
          "then": {"properties": {"path": {"pattern": "^fastapi/.+\\.py$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "upstream_project_metadata"}}, "required": ["kind"]},
          "then": {"properties": {"path": {"const": "pyproject.toml"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "upstream_lockfile"}}, "required": ["kind"]},
          "then": {"properties": {"path": {"const": "uv.lock"}}}
        }
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "argv",
        "cwd",
        "environment",
        "timeout_seconds",
        "observations",
        "source_evidence"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/caseId"},
        "argv": {"$ref": "#/$defs/argv"},
        "cwd": {"$ref": "#/$defs/cwd"},
        "environment": {"$ref": "#/$defs/environment"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "observations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["process.exit_code", "process.stdout", "process.stderr"]
          },
          "allOf": [
            {"contains": {"const": "process.exit_code"}},
            {"contains": {"const": "process.stdout"}},
            {"contains": {"const": "process.stderr"}}
          ]
        },
        "source_evidence": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceEvidence"}
        }
      },
      "allOf": [
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {"kind": {"const": "upstream_test"}},
                "required": ["kind"]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {"kind": {"const": "upstream_documentation"}},
                "required": ["kind"]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {"kind": {"const": "upstream_implementation_source"}},
                "required": ["kind"]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {"kind": {"const": "upstream_project_metadata"}},
                "required": ["kind"]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {"kind": {"const": "upstream_lockfile"}},
                "required": ["kind"]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
