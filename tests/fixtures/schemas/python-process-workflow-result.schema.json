{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-rs.dev/schemas/python-process-workflow-result/1",
  "title": "FastAPI-RS Python process workflow result v1",
  "description": "Identity-bound receipts from explicit oracle or target CLI process runs.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "started_at",
    "finished_at",
    "product",
    "profile",
    "identity",
    "manifest",
    "input",
    "command",
    "status",
    "cases",
    "infrastructure_errors"
  ],
  "properties": {
    "schema": {"const": "fastapi-rs/python-process-workflow-result@1"},
    "run_id": {"type": "string", "format": "uuid"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "product": {"enum": ["oracle", "target"]},
    "profile": {"$ref": "#/$defs/profile"},
    "identity": {
      "oneOf": [
        {"$ref": "#/$defs/identity"},
        {"type": "null"}
      ]
    },
    "manifest": {"$ref": "#/$defs/digestReference"},
    "input": {
      "type": "object",
      "required": ["path", "sha256", "schema"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"const": "fastapi-rs/python-process-workflow@1"}
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["mode", "entrypoint"],
      "properties": {
        "mode": {"enum": ["oracle", "target"]},
        "entrypoint": {
          "oneOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {"enum": ["completed", "incomplete", "unresolved"]},
    "unresolved_reason": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    },
    "infrastructure_errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/infrastructureError"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"product": {"const": "oracle"}}, "required": ["product"]},
      "then": {"properties": {"command": {"properties": {"mode": {"const": "oracle"}}}}}
    },
    {
      "if": {"properties": {"product": {"const": "target"}}, "required": ["product"]},
      "then": {"properties": {"command": {"properties": {"mode": {"const": "target"}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "unresolved"}}, "required": ["status"]},
      "then": {
        "properties": {
          "product": {"const": "target"},
          "profile": {
            "properties": {"status": {"const": "unresolved"}},
            "required": ["reason"]
          },
          "identity": {"type": "null"},
          "command": {"properties": {"entrypoint": {"type": "null"}}},
          "cases": {"maxItems": 0},
          "unresolved_reason": {"type": "string", "minLength": 1}
        },
        "required": ["unresolved_reason"]
      }
    },
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "profile": {"properties": {"status": {"const": "resolved"}}},
          "identity": {"$ref": "#/$defs/identity"},
          "command": {"properties": {"entrypoint": {"$ref": "#/$defs/fileIdentity"}}},
          "cases": {"minItems": 1},
          "infrastructure_errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {"const": "target"},
          "status": {"const": "completed"}
        },
        "required": ["product", "status"]
      },
      "then": {
        "properties": {
          "identity": {
            "required": [
              "distribution",
              "version",
              "target_revision",
              "source_tree_sha256",
              "target_binary_sha256"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["resolved", "unresolved"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "digestReference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "fileIdentity": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["profile_id", "profile_sha256", "python", "packages", "repositories", "entrypoint"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "distribution": {"const": "fastapi-rs"},
        "version": {"type": "string", "minLength": 1},
        "target_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "target_binary_sha256": {"$ref": "#/$defs/sha256"},
        "python": {
          "type": "object",
          "required": ["implementation", "version", "path", "sha256"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
        },
        "entrypoint": {"$ref": "#/$defs/fileIdentity"}
      },
      "additionalProperties": false
    },
    "byteRecord": {
      "type": "object",
      "required": ["encoding", "data", "sha256", "length_bytes"],
      "properties": {
        "encoding": {"const": "base64"},
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "length_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["selector", "value"],
      "properties": {
        "selector": {"enum": ["process.exit_code", "process.stdout", "process.stderr"]},
        "value": {
          "oneOf": [
            {"type": "integer"},
            {"$ref": "#/$defs/byteRecord"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"selector": {"const": "process.exit_code"}}, "required": ["selector"]},
          "then": {"properties": {"value": {"type": "integer"}}}
        },
        {
          "if": {"properties": {"selector": {"enum": ["process.stdout", "process.stderr"]}}, "required": ["selector"]},
          "then": {"properties": {"value": {"$ref": "#/$defs/byteRecord"}}}
        }
      ],
      "additionalProperties": false
    },
    "caseCommand": {
      "type": "object",
      "required": ["argv", "cwd", "environment"],
      "properties": {
        "argv": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "isolated-empty"}}, "additionalProperties": false},
        "environment": {
          "type": "object",
          "required": ["set", "unset", "inherited"],
          "properties": {
            "set": {"type": "object", "propertyNames": {"enum": ["COLUMNS", "FASTAPI_ENV", "LINES", "NO_COLOR", "PYTHONIOENCODING", "TERM"]}, "additionalProperties": {"type": "string"}},
            "unset": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["COLUMNS", "FASTAPI_ENV", "LINES", "NO_COLOR", "PYTHONIOENCODING", "TERM"]}},
            "inherited": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "status", "exit_code", "observations", "command", "timeout_seconds", "duration_seconds"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["completed", "timeout", "spawn_error"]},
        "exit_code": {"type": ["integer", "null"]},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "command": {"$ref": "#/$defs/caseCommand"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "minimum": 0},
        "error": {
          "type": "object",
          "required": ["type", "message"],
          "properties": {"type": {"type": "string", "minLength": 1}, "message": {"type": "string"}},
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {"properties": {"exit_code": {"type": "integer"}}, "not": {"required": ["error"]}}
        },
        {
          "if": {"properties": {"status": {"const": "timeout"}}, "required": ["status"]},
          "then": {"properties": {"exit_code": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "spawn_error"}}, "required": ["status"]},
          "then": {"properties": {"exit_code": {"type": "null"}, "observations": {"maxItems": 0}}, "required": ["error"]}
        }
      ],
      "additionalProperties": false
    },
    "infrastructureError": {
      "type": "object",
      "required": ["case_id", "kind", "message"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["timeout", "spawn_error"]},
        "message": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
