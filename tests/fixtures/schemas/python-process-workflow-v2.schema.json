{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-rs.dev/schemas/python-process-workflow/2",
  "title": "FastAPI-RS Python process workflow input v2",
  "description": "Input-only isolated process cases with bounded UTF-8 project trees and optional loopback HTTP server lifecycles; v2 execution requires POSIX process-group support.",
  "type": "object",
  "required": [
    "schema",
    "profiles",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "fastapi-rs/python-process-workflow@2"
    },
    "profiles": {
      "$ref": "#/$defs/profiles"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      },
      "maxItems": 128
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profiles": {
      "type": "object",
      "required": [
        "oracle",
        "target"
      ],
      "properties": {
        "oracle": {
          "enum": [
            "fastapi-0.157.0-starlette-1.6.0-cpython-3.12.13-core",
            "fastapi-0.157.0-starlette-1.6.0-cpython-3.12.13-standard"
          ]
        },
        "target": {
          "const": "fastapi-rs-python-consumer"
        }
      },
      "additionalProperties": false
    },
    "caseId": {
      "type": "string",
      "pattern": "^fastapi\\.cli\\.process\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "argv": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {
          "const": "fastapi"
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 64
    },
    "cwd": {
      "type": "object",
      "required": [
        "kind",
        "files"
      ],
      "properties": {
        "kind": {
          "const": "isolated-tree"
        },
        "files": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
              },
              "content": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "set",
        "unset"
      ],
      "properties": {
        "set": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "COLUMNS",
              "FASTAPI_ENV",
              "FASTAPI_PUBLIC_URL",
              "LINES",
              "NO_COLOR",
              "PORT",
              "PYTHONIOENCODING",
              "TERM"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "maxProperties": 8
        },
        "unset": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "COLUMNS",
              "FASTAPI_ENV",
              "FASTAPI_PUBLIC_URL",
              "LINES",
              "NO_COLOR",
              "PORT",
              "PYTHONIOENCODING",
              "TERM"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "path",
        "kind",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "kind": {
          "enum": [
            "upstream_test",
            "upstream_documentation",
            "upstream_implementation_source",
            "upstream_project_metadata",
            "upstream_lockfile"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "upstream_test"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^tests/.+\\.py$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "upstream_documentation"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^docs/en/docs/.+\\.md$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "upstream_implementation_source"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^fastapi/.+\\.py$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "upstream_project_metadata"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "pyproject.toml"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "upstream_lockfile"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "uv.lock"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "argv",
        "cwd",
        "environment",
        "timeout_seconds",
        "observations",
        "source_evidence",
        "execution"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "argv": {
          "$ref": "#/$defs/argv"
        },
        "cwd": {
          "$ref": "#/$defs/cwd"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "observations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "process.exit_code",
              "process.stdout",
              "process.stderr",
              "http.status",
              "http.body.bytes"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "process.exit_code"
              }
            }
          ]
        },
        "source_evidence": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceEvidence"
          },
          "maxItems": 32
        },
        "execution": {
          "$ref": "#/$defs/execution"
        }
      },
      "allOf": [
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "upstream_test"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "upstream_documentation"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "upstream_implementation_source"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "upstream_project_metadata"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "source_evidence": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "upstream_lockfile"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution": {
                "properties": {
                  "kind": {
                    "const": "command"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "execution"
            ]
          },
          "then": {
            "properties": {
              "observations": {
                "allOf": [
                  {
                    "contains": {
                      "const": "process.stdout"
                    }
                  },
                  {
                    "contains": {
                      "const": "process.stderr"
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "enum": [
                          "http.status",
                          "http.body.bytes"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution": {
                "properties": {
                  "kind": {
                    "const": "http-server"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "execution"
            ]
          },
          "then": {
            "properties": {
              "timeout_seconds": {
                "maximum": 60
              },
              "observations": {
                "maxItems": 3,
                "allOf": [
                  {
                    "contains": {
                      "const": "http.status"
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "enum": [
                          "process.stdout",
                          "process.stderr"
                        ]
                      }
                    }
                  }
                ]
              },
              "argv": {
                "prefixItems": [
                  {
                    "const": "fastapi"
                  },
                  {
                    "enum": [
                      "dev",
                      "run"
                    ]
                  }
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "requestPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/(?!/)[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*$"
    },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "command"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "readiness",
            "request",
            "shutdown"
          ],
          "properties": {
            "kind": {
              "const": "http-server"
            },
            "readiness": {
              "type": "object",
              "required": [
                "path",
                "timeout_seconds",
                "poll_interval_ms"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/requestPath"
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                },
                "poll_interval_ms": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 500
                }
              },
              "additionalProperties": false
            },
            "request": {
              "type": "object",
              "required": [
                "method",
                "path",
                "headers",
                "body",
                "timeout_seconds"
              ],
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS"
                  ]
                },
                "path": {
                  "$ref": "#/$defs/requestPath"
                },
                "headers": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": {
                    "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "body": {
                  "type": "string",
                  "maxLength": 65536
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15
                }
              },
              "additionalProperties": false
            },
            "shutdown": {
              "type": "object",
              "required": [
                "grace_seconds"
              ],
              "properties": {
                "grace_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
