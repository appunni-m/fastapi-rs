{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastapi-rs.dev/schemas/python-asgi-comparison/20",
  "title": "FastAPI-RS source/target comparison result v20",
  "description": "Version 20 accepts workflow v19 comparison results while retaining the v19 comparison contract.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "created_at",
    "scope",
    "manifest",
    "input",
    "source_result",
    "target_result",
    "command",
    "status",
    "summary",
    "cases",
    "infrastructure_errors"
  ],
  "properties": {
    "schema": {
      "const": "fastapi-rs/python-asgi-comparison@20"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "const": "input-defined-slice"
    },
    "manifest": {
      "$ref": "#/$defs/digestRef"
    },
    "input": {
      "allOf": [
        {
          "$ref": "#/$defs/digestRef"
        },
        {
          "type": "object",
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "enum": [
                "fastapi-rs/python-asgi-workflow@7",
                "fastapi-rs/python-asgi-workflow@8",
                "fastapi-rs/python-asgi-workflow@9",
                "fastapi-rs/python-asgi-workflow@10",
                "fastapi-rs/python-asgi-workflow@11",
                "fastapi-rs/python-asgi-workflow@12",
                "fastapi-rs/python-asgi-workflow@13",
                "fastapi-rs/python-asgi-workflow@14",
                "fastapi-rs/python-asgi-workflow@15",
                "fastapi-rs/python-asgi-workflow@16",
                "fastapi-rs/python-asgi-workflow@17",
                "fastapi-rs/python-asgi-workflow@18",
                "fastapi-rs/python-asgi-workflow@19"
              ]
            }
          }
        }
      ]
    },
    "source_result": {
      "$ref": "#/$defs/resultRef"
    },
    "target_result": {
      "$ref": "#/$defs/resultRef"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "const": "."
        }
      }
    },
    "status": {
      "const": "completed"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "passed",
        "failed",
        "not_run",
        "parity",
        "fault_contract"
      ],
      "properties": {
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_run": {
          "type": "integer",
          "minimum": 0
        },
        "parity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected",
            "executed",
            "passed",
            "failed",
            "skipped",
            "not_run",
            "infrastructure_errors"
          ],
          "properties": {
            "selected": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases declared in this verification lane."
            },
            "executed": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases for which comparison produced a pass or fail outcome. In the fault-contract lane, this counts target-side contract evaluations."
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases whose selected lane contract passed."
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases whose selected lane contract failed."
            },
            "not_run": {
              "type": "integer",
              "minimum": 0,
              "description": "Compatibility count of selected cases with outcome not_run; equal to skipped."
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "description": "Selected cases not compared because their outcome is not_run."
            },
            "infrastructure_errors": {
              "type": "integer",
              "const": 0,
              "description": "Always zero in a completed comparison; source or target infrastructure errors prevent comparison output."
            }
          }
        },
        "fault_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected",
            "executed",
            "passed",
            "failed",
            "skipped",
            "not_run",
            "infrastructure_errors",
            "oracle_status"
          ],
          "properties": {
            "selected": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases declared in this verification lane."
            },
            "executed": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases for which comparison produced a pass or fail outcome. In the fault-contract lane, this counts target-side contract evaluations."
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases whose selected lane contract passed."
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "description": "Cases whose selected lane contract failed."
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "description": "Selected cases not compared because their outcome is not_run."
            },
            "not_run": {
              "type": "integer",
              "minimum": 0,
              "description": "Compatibility count of selected cases with outcome not_run; equal to skipped."
            },
            "infrastructure_errors": {
              "type": "integer",
              "const": 0,
              "description": "Always zero in a completed comparison; source or target infrastructure errors prevent comparison output."
            },
            "oracle_status": {
              "const": "not_applicable"
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "infrastructure_errors": {
      "type": "array",
      "maxItems": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "run_id",
        "product"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "product": {
          "enum": [
            "oracle",
            "target"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "outcome",
        "diffs",
        "verification"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "diffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diff"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "parity",
            "fault-contract"
          ]
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "const": "fault-contract"
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "required": [
              "contract_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "const": "parity"
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "not": {
              "required": [
                "contract_id"
              ]
            }
          }
        }
      ]
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "path",
        "comparison",
        "source",
        "target"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "enum": [
            "exact",
            "ordered"
          ],
          "description": "Warnings use ordered comparison; other v5 fields retain their declared exact or ordered policy."
        },
        "source": {
          "type": [
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        },
        "target": {
          "type": [
            "null",
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        }
      }
    }
  }
}
